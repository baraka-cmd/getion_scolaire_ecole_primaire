# Configuration locale XAMPP
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_scolaire
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Sur InfinityFree, remplacez les valeurs ci-dessus par celles
# affichees dans Control Panel > MySQL Databases.
# Exemple :
# DB_HOST=sqlXXX.infinityfree.com
# DB_PORT=3306
# DB_NAME=if0_XXXXXXX_gestion_scolaire
# DB_USER=if0_XXXXXXX
# DB_PASS=votre_mot_de_passe
# DB_CHARSET=utf8mb4

SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# Public canonical URL used in password-reset links (trailing slash recommended).
APP_CANONICAL_URL=http://localhost/gestion_scolaire_ecole_primaire/

ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest
GEMINI_API_TIMEOUT=30
ASSISTANT_MAX_MESSAGE_LENGTH=4000
ASSISTANT_HISTORY_DAYS=60
ASSISTANT_RATE_LIMIT_WINDOW=3600
ASSISTANT_RATE_LIMIT_REQUESTS=30
ASSISTANT_UPLOAD_MAX_SIZE=5242880
ASSISTANT_IMPORT_MAX_ROWS=500

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost/gestion_scolaire_ecole_primaire/auth/google-callback2
# On production, replace the local URI with the exact HTTPS callback for that domain.

# Generate a separate VAPID pair and 32-byte encryption key for each environment.
# Keep both private values outside source control. PUSH_VAPID_SUBJECT must be a mailto: or HTTPS URL.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
APP_ENV=development
